{
  "name": "cerebro-web",
  "version": "0.3.1",
  "private": true,
  "description": "Open-source Next.js base for an online business of any kind — physical and digital products, appointments, sale by weight, quotes — with an admin panel and a guide for AI agents, in one repo you own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FacundoEquiss/cerebro-web"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "node scripts/check-brand.mjs && node --no-warnings scripts/check-i18n.mjs && node scripts/check-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "admin:hash": "node scripts/admin-hash.mjs",
    "data:export": "node scripts/export-catalog.mjs",
    "db:seed": "node scripts/generate-seed.mjs",
    "images": "node scripts/generate-images.mjs",
    "samples": "node scripts/generate-samples.mjs",
    "preset": "node scripts/preset.mjs",
    "brain": "node cerebro/armar.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "@types/nodemailer": "^8.0.2"
  },
  "keywords": [
    "admin",
    "bookings",
    "digital-products",
    "ecommerce",
    "kanban",
    "nextjs",
    "open-source",
    "quotes",
    "storefront",
    "template"
  ],
  "bugs": {
    "url": "https://github.com/FacundoEquiss/cerebro-web/issues"
  },
  "homepage": "https://github.com/FacundoEquiss/cerebro-web#readme"
}
