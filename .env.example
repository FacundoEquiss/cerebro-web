# Cerebro Web — environment variables.
# Copy this file to `.env.local` and fill in ONLY what you use. With everything empty the site
# runs in demo mode: demo catalogue, manual payments, nothing stored, measurement off.
# Every variable is validated at start-up (lib/env.ts): a mistake stops the server with a message.
# NEVER commit a file with real values. Variables that start with NEXT_PUBLIC_ reach the browser:
# never put a secret in one.

# ---------------------------------------------------------------------------------------------
# 1. THE SITE
# These three are needed when the site is BUILT as well as when it runs: pages are pre-rendered
# with them (canonical URLs, noindex). Change one → build again.
# ---------------------------------------------------------------------------------------------
# Public address of the store, without a trailing slash.
NEXT_PUBLIC_SITE_URL=
# "production" marks the real, public store (on Vercel this is detected on its own).
# Measurement and indexing only switch on in production.
APP_ENV=
# Set to 1 when the store is ready to appear in search engines. Anything else = noindex.
ALLOW_INDEXING=

# ---------------------------------------------------------------------------------------------
# 2. DATA — where products and orders live (docs/adapters.md)
# ---------------------------------------------------------------------------------------------
# json (default) | supabase | postgres
DATA_SOURCE=
# supabase: the project URL, the public key (read-only views) and the service key (SERVER only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# postgres: any PostgreSQL 14+.  postgres://user:password@host:5432/database
DATABASE_URL=
# json, local only: folder where orders, edited products and uploaded photos are written.
DATA_DIR=
# Signs the order receipts (and the admin session if ADMIN_SESSION_SECRET is empty).
# 32+ random characters. REQUIRED IN PRODUCTION, and with any database or payment gateway: the
# server refuses to start without it. On a laptop, when it is empty, a random secret is created
# in DATA_DIR — there is no built-in key.
# Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_SECRET=

# ---------------------------------------------------------------------------------------------
# 3. ADMIN PANEL (/admin)
# ---------------------------------------------------------------------------------------------
# email:hash pairs separated by commas. Create each one with:  npm run admin:hash
ADMIN_USERS=
# Signs the admin session cookie. 32+ random characters.
ADMIN_SESSION_SECRET=
# true = offer a READ-ONLY demo user with its password shown on the login screen.
# Empty = on only while the store is an unconfigured demo. Set it to false on a real store.
DEMO_MODE=
# Example orders in the admin panel. Empty = only in demo mode (a real store never gets them:
# they would hold real seats of real appointments). true = load them anyway (to try the panel on
# a laptop); false = never, not even in a demo.
DEMO_ORDERS=

# ---------------------------------------------------------------------------------------------
# 4. PAYMENTS (docs/adapters.md)
# ---------------------------------------------------------------------------------------------
# manual (default: bank transfer / arrange by WhatsApp) | mercadopago | stripe
# In production a gateway needs a database: with DATA_SOURCE=json the server refuses to start.
PAYMENT_PROVIDER=
MERCADOPAGO_ACCESS_TOKEN=
# The secret of the webhook: without it anyone could mark orders as paid.
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hours an UNPAID order may hold its stock. After that it is cancelled ("expired") and the units
# go back to the shelf. Default 48. 0 = never.
ORDER_EXPIRY_HOURS=
# Hours an UNPAID order keeps the slot of a service (appointments). Empty = `booking.holdHours` in
# config/commerce.ts (12). After it the seat is free at once; the order is cancelled by the clean-up.
BOOKING_HOLD_HOURS=
# Optional schedule for that clean-up (it also runs on its own when the panel or the checkout is
# used):  curl -H "Authorization: Bearer $CRON_SECRET" https://<domain>/api/cron/expire-orders
# 16+ random characters. On Vercel, vercel.json already calls it once a day with this secret.
CRON_SECRET=

# ---------------------------------------------------------------------------------------------
# 5. E-MAIL — order confirmation for the buyer, "new order" for the owner
# ---------------------------------------------------------------------------------------------
# console (default: only logs) | resend | smtp
MAIL_PROVIDER=
RESEND_API_KEY=
# smtps://user:password@host:465
SMTP_URL=
# The sender, e.g.  Your Brand <orders@example.com>
MAIL_FROM=
# Where the owner gets an e-mail for every new order.
ORDER_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------------------------
# 6. PHOTOS uploaded from the admin panel
# ---------------------------------------------------------------------------------------------
# local (default: DATA_DIR/uploads, needs a persistent disk) | supabase (a PUBLIC storage bucket)
STORAGE_PROVIDER=
SUPABASE_STORAGE_BUCKET=
# PRIVATE bucket for the files of the DIGITAL products (default: downloads). Create it as private:
# those files are only served through /api/downloads/…, to paid orders.
# The server checks that it is private before using it and refuses a public one.
SUPABASE_PRIVATE_BUCKET=

# ---------------------------------------------------------------------------------------------
# 7. ANTIBOT AND RATE LIMITS
# ---------------------------------------------------------------------------------------------
# Where the visitor's REAL address comes from (login and order limits count by it).
#   empty  → the last hop of X-Forwarded-For: right when ONE proxy sits in front of the server.
#            (On Vercel its own header is used automatically.)
#   a header name → the header YOUR proxy sets: cf-connecting-ip, x-real-ip, fly-client-ip…
#   none   → trust no header (the server is reached directly, with no proxy).
TRUSTED_PROXY_HEADER=
# none (default) | turnstile
ANTIBOT_PROVIDER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# 8. MEASUREMENT (optional). Off outside production, and only with the visitor's consent.
# ---------------------------------------------------------------------------------------------
# Analytics measurement id (starts with "G-").
NEXT_PUBLIC_GA4_ID=
GA4_API_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token: the server sends `purchase` with it, once per order.
META_CAPI_TOKEN=
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------------------------
# 9. SEARCH ENGINES (optional)
# ---------------------------------------------------------------------------------------------
# IndexNow key (8 to 128 letters, digits or dashes). Served at /indexnow-key.txt.
INDEXNOW_KEY=
